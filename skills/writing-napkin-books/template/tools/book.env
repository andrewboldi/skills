# Settings read by the shell tools (bash `source`) and by tools/pdfgrep.py. KEY="value" lines only.
BOOK_NAME="BOOK_FILE_NAME"     # outputs in the book root: <BOOK_NAME>.pdf and <BOOK_NAME>_with_papers.pdf
PAPERS_DIR="papers"            # downloaded arXiv PDFs and their manifest.tsv (git-ignored)
LETTER_PREFIXES=""             # lettered parts for build_chapter.sh, e.g. "cc:C hw:H" (cc03_x.tex is chapter C3)
LABEL_TYPES="part|ch|sec|subsec|fig|tab|eq|app|card|lst"   # allowed \label prefixes (tools/check.sh)
SPELLING="american"            # american: tools/check.sh runs tools/americanize.py; anything else skips that check
